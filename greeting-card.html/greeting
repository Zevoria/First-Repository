<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="x-apple-disable-message-reformatting">
  <title>Happy Birthday!</title>

  <style>
    body,
    table,
    td,
    a {
      -webkit-text-size-adjust: 100%;
      -ms-text-size-adjust: 100%;
    }

    table,
    td {
      mso-table-lspace: 0;
      mso-table-rspace: 0;
    }

    table {
      border-collapse: collapse !important;
    }

    img {
      border: 0;
      display: block;
      height: auto;
      line-height: 100%;
      outline: none;
      text-decoration: none;
    }

    @media screen and (max-width: 620px) {
      .email-container {
        width: 100% !important;
      }

      .card-padding {
        padding: 32px 20px !important;
      }

      .headline {
        font-size: 34px !important;
        line-height: 40px !important;
      }

      .button {
        display: block !important;
      }
    }
  </style>
</head>

<body style="margin:0; padding:0; background-color:#f7e8ef;">
  <!-- Hidden inbox preview text -->
  <div
    style="display:none; max-height:0; overflow:hidden;
           opacity:0; color:transparent; line-height:1px;
           font-size:1px;">
    A special birthday greeting is waiting for you!
  </div>

  <table
    role="presentation"
    width="100%"
    cellpadding="0"
    cellspacing="0"
    border="0"
    style="width:100%; background-color:#f7e8ef;">
    <tr>
      <td align="center" style="padding:32px 12px;">

        <table
          role="presentation"
          class="email-container"
          width="600"
          cellpadding="0"
          cellspacing="0"
          border="0"
          style="width:600px; max-width:600px;
                 background-color:#ffffff;
                 border-radius:18px;
                 overflow:hidden;">

          <!-- Banner -->
          <tr>
            <td
              align="center"
              style="padding:18px 24px;
                     background-color:#7c3aed;
                     color:#ffffff;
                     font-family:Arial, Helvetica, sans-serif;
                     font-size:16px;
                     font-weight:bold;
                     letter-spacing:1px;">
              A BIRTHDAY SURPRISE
            </td>
          </tr>

          <!-- Card content -->
          <tr>
            <td
              class="card-padding"
              align="center"
              style="padding:48px 50px;
                     font-family:Arial, Helvetica, sans-serif;">

              <div
                style="font-size:54px; line-height:64px;"
                aria-label="Birthday cake">
                🎂
              </div>

              <h1
                class="headline"
                style="margin:16px 0 12px;
                       color:#4c1d95;
                       font-family:Georgia, 'Times New Roman', serif;
                       font-size:42px;
                       line-height:48px;">
                Happy Birthday, Alex!
              </h1>

              <p
                style="margin:0 0 26px;
                       color:#4b5563;
                       font-size:18px;
                       line-height:29px;">
                Wishing you a wonderful day filled with laughter,
                good company, and everything that makes you smile.
              </p>

              <!-- Email-compatible button -->
              <table
                role="presentation"
                cellpadding="0"
                cellspacing="0"
                border="0"
                style="margin:0 auto;">
                <tr>
                  <td
                    align="center"
                    bgcolor="#ec4899"
                    style="border-radius:999px;">
                    <a
                      class="button"
                      href="https://example.com/your-card"
                      target="_blank"
                      style="display:inline-block;
                             padding:15px 30px;
                             border:1px solid #ec4899;
                             border-radius:999px;
                             color:#ffffff;
                             font-family:Arial, Helvetica, sans-serif;
                             font-size:17px;
                             font-weight:bold;
                             line-height:20px;
                             text-decoration:none;">
                      Open Your Card
                    </a>
                  </td>
                </tr>
              </table>

              <p
                style="margin:30px 0 0;
                       color:#6b7280;
                       font-size:15px;
                       line-height:23px;">
                With love,<br>
                <strong style="color:#374151;">Sam and the whole team</strong>
              </p>
            </td>
          </tr>

          <!-- Decorative footer -->
          <tr>
            <td
              align="center"
              style="padding:20px;
                     background-color:#fdf2f8;
                     color:#9d174d;
                     font-family:Arial, Helvetica, sans-serif;
                     font-size:14px;">
              ✨ Celebrate, laugh, and make a wish! ✨
            </td>
          </tr>
        </table>

        <p
          style="margin:18px 0 0;
                 color:#6b7280;
                 font-family:Arial, Helvetica, sans-serif;
                 font-size:12px;
                 line-height:18px;">
          Cannot use the button?
          <a
            href="https://example.com/your-card"
            style="color:#6d28d9;">
            Open the greeting in your browser
          </a>.
        </p>

      </td>
    </tr>
  </table>
</body>
</html>
